# ========================================================
# RUBY BRASIL - VARIÁVEIS DE AMBIENTE (.env.example)
# ========================================================

# 1. BANCO DE DADOS (PRISMA ORM)
# Desenvolvimento Local (SQLite):
DATABASE_URL="file:./dev.db"

# Produção (Vercel / Render / Supabase / Neon PostgreSQL):
# Descomente e substitua pela sua connection string em produção (altere o provider no schema.prisma para postgresql):
# DATABASE_URL="postgresql://usuario:senha@ep-xyz.us-east-2.aws.neon.tech/rubybrasil?sslmode=require"

# 2. URLs DA APLICAÇÃO E DOMÍNIO
# Local:
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Produção (coloque o seu domínio próprio aqui):
# NEXT_PUBLIC_APP_URL="https://rubybrasil.com.br"

# 3. TELEVENDAS & ATENDIMENTO VIA WHATSAPP (OMNICHANNEL)
# Número de WhatsApp do consultor que receberá os pedidos com DDI + DDD + Número:
NEXT_PUBLIC_WHATSAPP_NUMBER="5511999999999"

# 4. CHAVE PIX PARA RECEBIMENTO (OPCIONAL / CHECKOUT)
NEXT_PUBLIC_PIX_KEY="00020126580014br.gov.bcb.pix0136rubybrasil-chave-aleatoria-982135204000053039865802BR5920RUBY BRASIL LTDA6009SAO PAULO62070503***6304E8A2"

# 5. AUTENTICAÇÃO ADMINISTRATIVA & GMAIL SMTP
# Lista de e-mails autorizados para acessar o painel (separados por vírgula):
ADMIN_EMAILS="admin@rubybr.com.br,seuemail@gmail.com"

# Segredo criptográfico para tokens de sessão:
ADMIN_JWT_SECRET="gere_uma_chave_aleatoria_longa_aqui"

# Credenciais do Gmail SMTP (Google - conta de envio com Senha de App):
GMAIL_USER="seuemail@gmail.com"
GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"
